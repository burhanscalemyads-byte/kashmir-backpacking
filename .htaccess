# Hostinger (Apache / LiteSpeed) settings. Cloudflare Pages uses _headers and _redirects instead.

# Helper files stay private
RedirectMatch 302 ^/(tools/.*|README\.md|_headers|_redirects)$ /

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Pages, styles and scripts are re-checked on every visit, so edits show up straight away
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Images: cached for a day
  <FilesMatch "\.(jpe?g|png|webp|svg)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
