# Cloudflare Pages response headers. HTML, CSS and JS keep Pages' default
# (revalidate on every visit), so edits show up as soon as a deploy finishes.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Images: cached for a day. Swapping a photo under the same filename reaches
# repeat visitors within 24 hours; new visitors get it immediately.
/images/*
  Cache-Control: public, max-age=86400
